
# ── corp-webapp starter ─────────────────────────────────────────────────────
# Branding (see config/brand.php; logos in public/images/, colour in public/css/theme.css)
ORG_NAME="Generic Corp"
ORG_LOCATION=

# Local admin (created once by the seeder; never reset). Leave empty for a random password in the log.
ADMIN_INITIAL_PASSWORD=

# Active Directory (read-only). Service account password only here, never in code.
LDAP_ENABLED=true
LDAP_HOST=dc01.corp.example
LDAP_PORT=389
LDAP_BIND_USER=
LDAP_BIND_PASS=
LDAP_BASE_DN="DC=corp,DC=example"
LDAP_SEARCH_OU="OU=Users,DC=corp,DC=example"
LDAP_DOMAIN_LABEL=corp.example
LDAP_DEFAULT_ROLE=worker
LDAP_AUTO_CREATE=false

# Maps: default centre "lat,lng"; CARTO basemaps key bound to the app's domain
# (https://dashboard.basemaps.carto.com); empty = OSM tiles
MAP_CENTER="51.5074,-0.1278"
CARTO=
